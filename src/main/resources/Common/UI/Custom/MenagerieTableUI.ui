$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 480, Height: 410);

    #Title {
        Label {
            Text: "MENAGERIE TABLE";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            // Flask selection label
            Label #FlaskSectionLabel {
                Text: "Select a Full Flask";
                Anchor: (Top: 6, Bottom: 8);
                Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center);
            }

            // Flask slots row
            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 96);

                Group {
                    LayoutMode: Left;

                    // Slot 0
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 68);

                        Group #MenFlaskHighlight0 {
                            Anchor: (Width: 68, Height: 68);
                            Background: #00000000;
                            Padding: 2;

                            ItemSlotButton #MenFlaskButton0 {
                                Anchor: (Full: 0);
                                Style: (
                                    Default: (Background: #1a2530),
                                    Hovered: (Background: #c9a050),
                                    Pressed: (Background: #a08040)
                                );
                                Group {
                                    Anchor: (Full: 0);
                                    Padding: 2;
                                    HitTestVisible: false;
                                    Group {
                                        Anchor: (Full: 0);
                                        Background: "Common/BlockSelectorSlotBackground.png";
                                        HitTestVisible: false;
                                        ItemSlot #MenFlaskIcon0 {
                                            Anchor: (Full: 0);
                                            ShowQualityBackground: true;
                                            HitTestVisible: false;
                                        }
                                    }
                                }
                            }
                        }

                        Label #MenFlaskFill0 {
                            Anchor: (Height: 20, Top: 4);
                            Style: (FontSize: 13, TextColor: #90a0b0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }

                    Group { Anchor: (Width: 16); }

                    // Slot 1
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 68);

                        Group #MenFlaskHighlight1 {
                            Anchor: (Width: 68, Height: 68);
                            Background: #00000000;
                            Padding: 2;

                            ItemSlotButton #MenFlaskButton1 {
                                Anchor: (Full: 0);
                                Style: (
                                    Default: (Background: #1a2530),
                                    Hovered: (Background: #c9a050),
                                    Pressed: (Background: #a08040)
                                );
                                Group {
                                    Anchor: (Full: 0);
                                    Padding: 2;
                                    HitTestVisible: false;
                                    Group {
                                        Anchor: (Full: 0);
                                        Background: "Common/BlockSelectorSlotBackground.png";
                                        HitTestVisible: false;
                                        ItemSlot #MenFlaskIcon1 {
                                            Anchor: (Full: 0);
                                            ShowQualityBackground: true;
                                            HitTestVisible: false;
                                        }
                                    }
                                }
                            }
                        }

                        Label #MenFlaskFill1 {
                            Anchor: (Height: 20, Top: 4);
                            Style: (FontSize: 13, TextColor: #90a0b0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }

                    Group { Anchor: (Width: 16); }

                    // Slot 2
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 68);

                        Group #MenFlaskHighlight2 {
                            Anchor: (Width: 68, Height: 68);
                            Background: #00000000;
                            Padding: 2;

                            ItemSlotButton #MenFlaskButton2 {
                                Anchor: (Full: 0);
                                Style: (
                                    Default: (Background: #1a2530),
                                    Hovered: (Background: #c9a050),
                                    Pressed: (Background: #a08040)
                                );
                                Group {
                                    Anchor: (Full: 0);
                                    Padding: 2;
                                    HitTestVisible: false;
                                    Group {
                                        Anchor: (Full: 0);
                                        Background: "Common/BlockSelectorSlotBackground.png";
                                        HitTestVisible: false;
                                        ItemSlot #MenFlaskIcon2 {
                                            Anchor: (Full: 0);
                                            ShowQualityBackground: true;
                                            HitTestVisible: false;
                                        }
                                    }
                                }
                            }
                        }

                        Label #MenFlaskFill2 {
                            Anchor: (Height: 20, Top: 4);
                            Style: (FontSize: 13, TextColor: #90a0b0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }
                }
            }

            $C.@ContentSeparator {
                Anchor: (Top: 8, Bottom: 8);
            }

            // Flask detail panel
            Label #FlaskDetailHeader {
                Text: "";
                Anchor: (Bottom: 4);
                Padding: (Horizontal: 20);
                Style: (FontSize: 16, TextColor: #c9a050, HorizontalAlignment: Center, RenderBold: true);
            }

            Label #FlaskDetailContents {
                Text: "";
                Anchor: (Bottom: 8);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #90a0b0, HorizontalAlignment: Center, Wrap: true);
            }

            $C.@ContentSeparator {
                Anchor: (Top: 6, Bottom: 6);
            }

            // Requirements row
            Label {
                Text: "Requires:";
                Anchor: (Bottom: 4);
                Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center);
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 40);

                Group {
                    LayoutMode: Left;

                    Group {
                        Anchor: (Width: 36, Height: 36);
                        Background: "Common/BlockSelectorSlotBackground.png";

                        ItemSlot #LifeEssenceIcon {
                            Anchor: (Full: 0);
                            ShowQualityBackground: true;
                            HitTestVisible: false;
                        }
                    }

                    Group { Anchor: (Width: 8); }

                    Label #LifeEssenceLabel {
                        Anchor: (Height: 36);
                        Style: (FontSize: 14, TextColor: #90a0b0, VerticalAlignment: Center);
                        Text: "1x Life Essence";
                    }
                }
            }

            $C.@ContentSeparator {
                Anchor: (Top: 6, Bottom: 10);
            }

            // Craft button
            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 44, Bottom: 8);

                ItemSlotButton #CraftButton {
                    Anchor: (Width: 220, Height: 38);
                    Style: (
                        Default: (Background: #1a3a20),
                        Hovered: (Background: #2a6a38),
                        Pressed: (Background: #1a4828)
                    );

                    Label #CraftLabel {
                        Anchor: (Full: 0);
                        HitTestVisible: false;
                        Style: (FontSize: 16, TextColor: #60d080, HorizontalAlignment: Center,
                                VerticalAlignment: Center, RenderBold: true);
                        Text: "Select a Flask First";
                    }
                }
            }
        }
    }
}

$C.@BackButton {}