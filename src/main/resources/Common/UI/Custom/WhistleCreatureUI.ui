$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 440, Height: 320);

    #Title {
        Label {
            Text: "RUNEBOUND WHISTLE";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            // Phase label
            Label #PhaseLabel {
                Text: "";
                Anchor: (Top: 8, Bottom: 6);
                Style: (FontSize: 14, TextColor: #c0a060, HorizontalAlignment: Center, RenderBold: true);
            }

            $C.@ContentSeparator {
                Anchor: (Bottom: 6);
            }

            // ── Creature list slots (3 per page) ──────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 38, Bottom: 2);
                ItemSlotButton #Slot0Button {
                    Anchor: (Left: 8, Right: 8, Full: 0);
                    Style: (Default: (Background: #161e28), Hovered: (Background: #263050), Pressed: (Background: #121820));
                    Label #Slot0Label {
                        Anchor: (Full: 0);
                        Padding: (Horizontal: 12);
                        HitTestVisible: false;
                        Style: (FontSize: 13, TextColor: #d0d0d0, VerticalAlignment: Center);
                        Text: "";
                    }
                }
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 38, Bottom: 2);
                ItemSlotButton #Slot1Button {
                    Anchor: (Left: 8, Right: 8, Full: 0);
                    Style: (Default: (Background: #161e28), Hovered: (Background: #263050), Pressed: (Background: #121820));
                    Label #Slot1Label {
                        Anchor: (Full: 0);
                        Padding: (Horizontal: 12);
                        HitTestVisible: false;
                        Style: (FontSize: 13, TextColor: #d0d0d0, VerticalAlignment: Center);
                        Text: "";
                    }
                }
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 38, Bottom: 2);
                ItemSlotButton #Slot2Button {
                    Anchor: (Left: 8, Right: 8, Full: 0);
                    Style: (Default: (Background: #161e28), Hovered: (Background: #263050), Pressed: (Background: #121820));
                    Label #Slot2Label {
                        Anchor: (Full: 0);
                        Padding: (Horizontal: 12);
                        HitTestVisible: false;
                        Style: (FontSize: 13, TextColor: #d0d0d0, VerticalAlignment: Center);
                        Text: "";
                    }
                }
            }

            // ── Pagination row ────────────────────────────────────────────────

            $C.@ContentSeparator {
                Anchor: (Top: 4, Bottom: 4);
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 28, Bottom: 6);

                Group {
                    LayoutMode: Left;
                    Anchor: (Width: 300, Height: 28);

                    ItemSlotButton #PrevButton {
                        Anchor: (Width: 80, Height: 28);
                        Style: (Default: (Background: #1a2030), Hovered: (Background: #2a3050), Pressed: (Background: #121820));
                        Label #PrevLabel {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 12, TextColor: #8090a8, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "< Prev";
                        }
                    }

                    Label #PageLabel {
                        Anchor: (Width: 140, Height: 28);
                        Style: (FontSize: 12, TextColor: #5a6a7a, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Text: "1 / 1";
                    }

                    ItemSlotButton #NextButton {
                        Anchor: (Width: 80, Height: 28);
                        Style: (Default: (Background: #1a2030), Hovered: (Background: #2a3050), Pressed: (Background: #121820));
                        Label #NextLabel {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 12, TextColor: #8090a8, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Next >";
                        }
                    }
                }
            }

            // ── Back button ───────────────────────────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 34);

                ItemSlotButton #BackButton {
                    Anchor: (Width: 160, Height: 30);
                    Style: (Default: (Background: #1e1e28), Hovered: (Background: #2e2e40), Pressed: (Background: #161620));
                    Label #BackLabel {
                        Anchor: (Full: 0);
                        HitTestVisible: false;
                        Style: (FontSize: 12, TextColor: #707888, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Text: "Back";
                    }
                }
            }
        }
    }
}

$C.@BackButton {}