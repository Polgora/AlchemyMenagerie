$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 400, Height: 200);

    #Title {
        Label {
            Text: "MENAGERIE JOURNAL";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            Label #SubtitleLabel {
                Text: "Your creature records";
                Anchor: (Top: 12, Bottom: 12);
                Style: (FontSize: 13, TextColor: #a0b8c0, HorizontalAlignment: Center, VerticalAlignment: Center);
            }

            $C.@ContentSeparator {
                Anchor: (Bottom: 16);
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 34);

                ItemSlotButton #CloseButton {
                    Anchor: (Width: 160, Height: 30);
                    Style: (Default: (Background: #1e1e28), Hovered: (Background: #2e2e40), Pressed: (Background: #161620));
                    Label #CloseLabel {
                        Anchor: (Full: 0);
                        HitTestVisible: false;
                        Style: (FontSize: 12, TextColor: #707888, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Text: "Close";
                    }
                }
            }
        }
    }
}

$C.@BackButton {}