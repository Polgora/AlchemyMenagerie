$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 520, Height: 405);

    #Title {
        Label {
            Text: "MENAGERIE JOURNAL";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            // ── Tab bar ───────────────────────────────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 30, Bottom: 4);
                Group {
                    LayoutMode: Left;
                    Anchor: (Width: 492, Height: 30);

                    ItemSlotButton #TabCreaturesButton {
                        Anchor: (Width: 120, Height: 30);
                        Style: (Default: (Background: #2a4870), Hovered: (Background: #3a5880), Pressed: (Background: #1a3060));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #c9a050, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
                            Text: "Creatures";
                        }
                    }

                    ItemSlotButton #TabBestiaryButton {
                        Anchor: (Left: 4, Width: 120, Height: 30);
                        Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Bestiary";
                        }
                    }

                    ItemSlotButton #TabDiscoveriesButton {
                        Anchor: (Left: 4, Width: 120, Height: 30);
                        Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Discoveries";
                        }
                    }

                    ItemSlotButton #TabRecipesButton {
                        Anchor: (Left: 4, Width: 120, Height: 30);
                        Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Recipes";
                        }
                    }
                }
            }

            $C.@ContentSeparator {
                Anchor: (Top: 8, Bottom: 8);
            }

            // ── Living / Deceased sub-tab row ─────────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 26, Bottom: 6);
                Group {
                    LayoutMode: Left;
                    Anchor: (Width: 260, Height: 26);

                    ItemSlotButton #ViewLivingButton {
                        Anchor: (Width: 128, Height: 26);
                        Style: (Default: (Background: #2a4870), Hovered: (Background: #3a5880), Pressed: (Background: #1a3060));
                        Label #ViewLivingLabel {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #c9a050, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Living";
                        }
                    }

                    ItemSlotButton #ViewDeceasedButton {
                        Anchor: (Left: 4, Width: 128, Height: 26);
                        Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                        Label #ViewDeceasedLabel {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Deceased";
                        }
                    }
                }
            }

            // ── Slot rows ─────────────────────────────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 38, Bottom: 2);
                ItemSlotButton #Slot0Button {
                    Anchor: (Width: 496, Height: 38);
                    Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                    Label #Slot0Label {
                        Anchor: (Full: 0);
                        Padding: (Horizontal: 10);
                        HitTestVisible: false;
                        Style: (FontSize: 16, TextColor: #c0d0e0, VerticalAlignment: Center);
                        Text: "";
                    }
                }
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 38, Bottom: 2);
                ItemSlotButton #Slot1Button {
                    Anchor: (Width: 496, Height: 38);
                    Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                    Label #Slot1Label {
                        Anchor: (Full: 0);
                        Padding: (Horizontal: 10);
                        HitTestVisible: false;
                        Style: (FontSize: 16, TextColor: #c0d0e0, VerticalAlignment: Center);
                        Text: "";
                    }
                }
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 38, Bottom: 2);
                ItemSlotButton #Slot2Button {
                    Anchor: (Width: 496, Height: 38);
                    Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                    Label #Slot2Label {
                        Anchor: (Full: 0);
                        Padding: (Horizontal: 10);
                        HitTestVisible: false;
                        Style: (FontSize: 16, TextColor: #c0d0e0, VerticalAlignment: Center);
                        Text: "";
                    }
                }
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 38, Bottom: 2);
                ItemSlotButton #Slot3Button {
                    Anchor: (Width: 496, Height: 38);
                    Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                    Label #Slot3Label {
                        Anchor: (Full: 0);
                        Padding: (Horizontal: 10);
                        HitTestVisible: false;
                        Style: (FontSize: 16, TextColor: #c0d0e0, VerticalAlignment: Center);
                        Text: "";
                    }
                }
            }

            // ── Pagination ────────────────────────────────────────────────────

            $C.@ContentSeparator {
                Anchor: (Top: 8, Bottom: 8);
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 28, Bottom: 6);
                Group {
                    LayoutMode: Left;
                    Anchor: (Width: 300, Height: 28);
                    ItemSlotButton #PrevButton {
                        Anchor: (Width: 80, Height: 28);
                        Style: (Default: (Background: #1a2530), Hovered: (Background: #c9a050), Pressed: (Background: #a08040));
                        Label #PrevLabel {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #c0d0e0, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "";
                        }
                    }
                    Label #PageLabel {
                        Anchor: (Width: 140, Height: 28);
                        Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Text: "1 / 1";
                    }
                    ItemSlotButton #NextButton {
                        Anchor: (Width: 80, Height: 28);
                        Style: (Default: (Background: #1a2530), Hovered: (Background: #c9a050), Pressed: (Background: #a08040));
                        Label #NextLabel {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #c0d0e0, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "";
                        }
                    }
                }
            }

            // ── Close button ──────────────────────────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 34);
                ItemSlotButton #CloseButton {
                    Anchor: (Width: 160, Height: 30);
                    Style: (Default: (Background: #1a2530), Hovered: (Background: #c9a050), Pressed: (Background: #a08040));
                    Label {
                        Anchor: (Full: 0);
                        HitTestVisible: false;
                        Style: (FontSize: 16, TextColor: #c0d0e0, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Text: "Close";
                    }
                }
            }
        }
    }
}

$C.@BackButton {}