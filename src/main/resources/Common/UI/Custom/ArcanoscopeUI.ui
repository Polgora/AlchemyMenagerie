$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 380, Height: 520);

    #Title {
        Label #BlockNameLabel {
            Text: "";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            Label #HelpText {
                Text: "";
                Anchor: (Top: 8, Bottom: 4);
                Style: (FontSize: 14, TextColor: #a080c0, HorizontalAlignment: Center);
            }

            Label #HarvestPowerLabel {
                Text: "";
                Anchor: (Bottom: 8);
                Style: (FontSize: 12, TextColor: #5a6a7a, HorizontalAlignment: Center);
            }

            $C.@ContentSeparator {
                Anchor: (Top: 0, Bottom: 8);
            }

            Label {
                Text: "Elements";
                Anchor: (Top: 0, Bottom: 8);
                Style: (FontSize: 14, TextColor: #5a6a7a, HorizontalAlignment: Center);
            }

            Group #ElementList {
                LayoutMode: Top;
                Padding: (Horizontal: 30);
            }

            $C.@ContentSeparator {
                Anchor: (Top: 8, Bottom: 8);
            }

            Label #FlaskSectionLabel {
                Text: "Flask Pouch";
                Anchor: (Top: 0, Bottom: 8);
                Style: (FontSize: 14, TextColor: #5a6a7a, HorizontalAlignment: Center);
            }

            // Three flask icon slots
            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 86);

                Group {
                    LayoutMode: Left;

                    // Slot 0
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 68);

                        Group #ArcFlaskHighlight0 {
                            Anchor: (Width: 68, Height: 68);
                            Background: #00000000;
                            Padding: 2;

                            ItemSlotButton #ArcFlaskButton0 {
                                Anchor: (Full: 0);
                                Style: (
                                    Default: (Background: #1a2530),
                                    Hovered: (Background: #c9a050),
                                    Pressed: (Background: #a08040)
                                );
                                Group {
                                    Anchor: (Full: 0);
                                    Padding: 2;
                                    HitTestVisible: false;
                                    Group {
                                        Anchor: (Full: 0);
                                        Background: "Common/BlockSelectorSlotBackground.png";
                                        HitTestVisible: false;
                                        ItemSlot #ArcFlaskIcon0 {
                                            Anchor: (Full: 0);
                                            ShowQualityBackground: true;
                                            HitTestVisible: false;
                                        }
                                    }
                                }
                            }
                        }

                        Label #ArcFlaskFill0 {
                            Anchor: (Height: 16, Top: 2);
                            Style: (FontSize: 11, TextColor: #8090a0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }

                    Group { Anchor: (Width: 12); }

                    // Slot 1
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 68);

                        Group #ArcFlaskHighlight1 {
                            Anchor: (Width: 68, Height: 68);
                            Background: #00000000;
                            Padding: 2;

                            ItemSlotButton #ArcFlaskButton1 {
                                Anchor: (Full: 0);
                                Style: (
                                    Default: (Background: #1a2530),
                                    Hovered: (Background: #c9a050),
                                    Pressed: (Background: #a08040)
                                );
                                Group {
                                    Anchor: (Full: 0);
                                    Padding: 2;
                                    HitTestVisible: false;
                                    Group {
                                        Anchor: (Full: 0);
                                        Background: "Common/BlockSelectorSlotBackground.png";
                                        HitTestVisible: false;
                                        ItemSlot #ArcFlaskIcon1 {
                                            Anchor: (Full: 0);
                                            ShowQualityBackground: true;
                                            HitTestVisible: false;
                                        }
                                    }
                                }
                            }
                        }

                        Label #ArcFlaskFill1 {
                            Anchor: (Height: 16, Top: 2);
                            Style: (FontSize: 11, TextColor: #8090a0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }

                    Group { Anchor: (Width: 12); }

                    // Slot 2
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 68);

                        Group #ArcFlaskHighlight2 {
                            Anchor: (Width: 68, Height: 68);
                            Background: #00000000;
                            Padding: 2;

                            ItemSlotButton #ArcFlaskButton2 {
                                Anchor: (Full: 0);
                                Style: (
                                    Default: (Background: #1a2530),
                                    Hovered: (Background: #c9a050),
                                    Pressed: (Background: #a08040)
                                );
                                Group {
                                    Anchor: (Full: 0);
                                    Padding: 2;
                                    HitTestVisible: false;
                                    Group {
                                        Anchor: (Full: 0);
                                        Background: "Common/BlockSelectorSlotBackground.png";
                                        HitTestVisible: false;
                                        ItemSlot #ArcFlaskIcon2 {
                                            Anchor: (Full: 0);
                                            ShowQualityBackground: true;
                                            HitTestVisible: false;
                                        }
                                    }
                                }
                            }
                        }

                        Label #ArcFlaskFill2 {
                            Anchor: (Height: 16, Top: 2);
                            Style: (FontSize: 11, TextColor: #8090a0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }
                }
            }

            $C.@ContentSeparator {
                Anchor: (Top: 8, Bottom: 8);
            }

            // Flask detail panel — populates when a flask is selected
            Label #FlaskDetailHeader {
                Text: "";
                Anchor: (Bottom: 4);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #c9a050, HorizontalAlignment: Center, RenderBold: true);
            }

            Label #FlaskDetailContents {
                Text: "";
                Anchor: (Bottom: 10);
                Padding: (Horizontal: 20);
                Style: (FontSize: 12, TextColor: #8090a0, HorizontalAlignment: Center, Wrap: true);
            }

            // Confirm button
            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 44, Bottom: 8);

                ItemSlotButton #ConfirmButton {
                    Anchor: (Width: 200, Height: 36);
                    Style: (
                        Default: (Background: #1a3a20),
                        Hovered: (Background: #2a6a38),
                        Pressed: (Background: #1a4828)
                    );
                    Label #ConfirmLabel {
                        Anchor: (Full: 0);
                        HitTestVisible: false;
                        Style: (FontSize: 14, TextColor: #60d080, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
                        Text: "Select an Element First";
                    }
                }
            }

        }
    }
}