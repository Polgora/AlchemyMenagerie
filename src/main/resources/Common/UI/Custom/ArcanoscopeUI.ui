$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 320, Height: 500);

    #Title {
        Label #BlockNameLabel {
            Text: "";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            $C.@ContentSeparator {
                Anchor: (Top: 8, Bottom: 6);
            }

            Label #HelpText {
                Text: "";
                Anchor: (Bottom: 8);
                Style: (FontSize: 12, TextColor: #a080c0, HorizontalAlignment: Center);
            }

            $C.@ContentSeparator {
                Anchor: (Bottom: 8);
            }

            Label {
                Text: "Elements";
                Anchor: (Bottom: 6);
                Style: (FontSize: 13, TextColor: #5a6a7a, HorizontalAlignment: Center);
            }

            Group #ElementList {
                LayoutMode: Top;
                Padding: (Horizontal: 30);
            }

            $C.@ContentSeparator {
                Anchor: (Top: 10, Bottom: 6);
            }

            Label #FlaskSectionLabel {
                Text: "Flask Pouch";
                Anchor: (Bottom: 8);
                Style: (FontSize: 13, TextColor: #5a6a7a, HorizontalAlignment: Center);
            }

            // Three flask icon slots, identical in layout to the Flask Pouch UI
            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 82);

                Group {
                    LayoutMode: Left;

                    // Slot 0
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 64);

                        ItemSlotButton #ArcFlaskButton0 {
                            Anchor: (Width: 64, Height: 64);
                            Style: (
                                Default: (Background: #1a2530),
                                Hovered: (Background: #c9a050),
                                Pressed: (Background: #a08040)
                            );
                            Group {
                                Anchor: (Full: 0);
                                Padding: 2;
                                HitTestVisible: false;
                                Group {
                                    Anchor: (Full: 0);
                                    Background: "Common/BlockSelectorSlotBackground.png";
                                    HitTestVisible: false;
                                    ItemSlot #ArcFlaskIcon0 {
                                        Anchor: (Full: 0);
                                        ShowQualityBackground: true;
                                        HitTestVisible: false;
                                    }
                                }
                            }
                        }

                        Label #ArcFlaskFill0 {
                            Anchor: (Height: 16, Top: 2);
                            Style: (FontSize: 11, TextColor: #8090a0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }

                    Group { Anchor: (Width: 12); }

                    // Slot 1
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 64);

                        ItemSlotButton #ArcFlaskButton1 {
                            Anchor: (Width: 64, Height: 64);
                            Style: (
                                Default: (Background: #1a2530),
                                Hovered: (Background: #c9a050),
                                Pressed: (Background: #a08040)
                            );
                            Group {
                                Anchor: (Full: 0);
                                Padding: 2;
                                HitTestVisible: false;
                                Group {
                                    Anchor: (Full: 0);
                                    Background: "Common/BlockSelectorSlotBackground.png";
                                    HitTestVisible: false;
                                    ItemSlot #ArcFlaskIcon1 {
                                        Anchor: (Full: 0);
                                        ShowQualityBackground: true;
                                        HitTestVisible: false;
                                    }
                                }
                            }
                        }

                        Label #ArcFlaskFill1 {
                            Anchor: (Height: 16, Top: 2);
                            Style: (FontSize: 11, TextColor: #8090a0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }

                    Group { Anchor: (Width: 12); }

                    // Slot 2
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 64);

                        ItemSlotButton #ArcFlaskButton2 {
                            Anchor: (Width: 64, Height: 64);
                            Style: (
                                Default: (Background: #1a2530),
                                Hovered: (Background: #c9a050),
                                Pressed: (Background: #a08040)
                            );
                            Group {
                                Anchor: (Full: 0);
                                Padding: 2;
                                HitTestVisible: false;
                                Group {
                                    Anchor: (Full: 0);
                                    Background: "Common/BlockSelectorSlotBackground.png";
                                    HitTestVisible: false;
                                    ItemSlot #ArcFlaskIcon2 {
                                        Anchor: (Full: 0);
                                        ShowQualityBackground: true;
                                        HitTestVisible: false;
                                    }
                                }
                            }
                        }

                        Label #ArcFlaskFill2 {
                            Anchor: (Height: 16, Top: 2);
                            Style: (FontSize: 11, TextColor: #8090a0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }
                }
            }

            // Flask contents — always visible, one line per flask
            $C.@ContentSeparator {
                Anchor: (Top: 10, Bottom: 6);
            }

            Label { Text: "Flask Contents"; Anchor: (Bottom: 4); Style: (FontSize: 13, TextColor: #5a6a7a, HorizontalAlignment: Center); }

            Label #FlaskInfo0 { Text: ""; Anchor: (Bottom: 2); Padding: (Horizontal: 20); Style: (FontSize: 11, TextColor: #8090a0, HorizontalAlignment: Center); }
            Label #FlaskInfo1 { Text: ""; Anchor: (Bottom: 2); Padding: (Horizontal: 20); Style: (FontSize: 11, TextColor: #8090a0, HorizontalAlignment: Center); }
            Label #FlaskInfo2 { Text: ""; Anchor: (Bottom: 6); Padding: (Horizontal: 20); Style: (FontSize: 11, TextColor: #8090a0, HorizontalAlignment: Center); }
        }
    }
}