$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 420, Height: 620);

    #Title {
        Label #BlockNameLabel {
            Text: "";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            Label #HelpText {
                Text: "";
                Anchor: (Top: 10, Bottom: 6);
                Style: (FontSize: 16, TextColor: #a080c0, HorizontalAlignment: Center);
            }

            // Harvest power stepper
            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 32, Bottom: 10);

                Group {
                    LayoutMode: Left;

                    Label {
                        Text: "Harvest Power";
                        Anchor: (Height: 32);
                        Style: (FontSize: 14, TextColor: #6a7a8a, VerticalAlignment: Center);
                    }

                    Group { Anchor: (Width: 10); }

                    Button #PowerDecreaseButton {
                        Anchor: (Width: 28, Height: 28);
                        Style: (
                            Default: (Background: #1a2530),
                            Hovered: (Background: #c9a050),
                            Pressed: (Background: #a08040)
                        );
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Text: "<";
                            Style: (FontSize: 16, TextColor: #c0d0e0, HorizontalAlignment: Center, VerticalAlignment: Center);
                        }
                    }

                    Group { Anchor: (Width: 6); }

                    Label #PowerValueLabel {
                        Anchor: (Width: 52, Height: 32);
                        Text: "50%";
                        Style: (FontSize: 16, TextColor: #c9a050, HorizontalAlignment: Center,
                                VerticalAlignment: Center, RenderBold: true);
                    }

                    Group { Anchor: (Width: 6); }

                    Button #PowerIncreaseButton {
                        Anchor: (Width: 28, Height: 28);
                        Style: (
                            Default: (Background: #1a2530),
                            Hovered: (Background: #c9a050),
                            Pressed: (Background: #a08040)
                        );
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Text: ">";
                            Style: (FontSize: 16, TextColor: #c0d0e0, HorizontalAlignment: Center, VerticalAlignment: Center);
                        }
                    }
                }
            }

            $C.@ContentSeparator {
                Anchor: (Top: 0, Bottom: 10);
            }

            Label {
                Text: "Elements";
                Anchor: (Top: 0, Bottom: 8);
                Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center);
            }

            Group #ElementList {
                LayoutMode: Top;
                Padding: (Horizontal: 20);
            }

            $C.@ContentSeparator {
                Anchor: (Top: 10, Bottom: 10);
            }

            Label #FlaskSectionLabel {
                Text: "Flask Pouch";
                Anchor: (Top: 0, Bottom: 8);
                Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center);
            }

            // Three flask icon slots
            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 96);

                Group {
                    LayoutMode: Left;

                    // Slot 0
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 68);

                        Group #ArcFlaskHighlight0 {
                            Anchor: (Width: 68, Height: 68);
                            Background: #00000000;
                            Padding: 2;

                            ItemSlotButton #ArcFlaskButton0 {
                                Anchor: (Full: 0);
                                Style: (
                                    Default: (Background: #1a2530),
                                    Hovered: (Background: #c9a050),
                                    Pressed: (Background: #a08040)
                                );
                                Group {
                                    Anchor: (Full: 0);
                                    Padding: 2;
                                    HitTestVisible: false;
                                    Group {
                                        Anchor: (Full: 0);
                                        Background: "Common/BlockSelectorSlotBackground.png";
                                        HitTestVisible: false;
                                        ItemSlot #ArcFlaskIcon0 {
                                            Anchor: (Full: 0);
                                            ShowQualityBackground: true;
                                            HitTestVisible: false;
                                        }
                                    }
                                }
                            }
                        }

                        Label #ArcFlaskFill0 {
                            Anchor: (Height: 20, Top: 4);
                            Style: (FontSize: 13, TextColor: #90a0b0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }

                    Group { Anchor: (Width: 16); }

                    // Slot 1
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 68);

                        Group #ArcFlaskHighlight1 {
                            Anchor: (Width: 68, Height: 68);
                            Background: #00000000;
                            Padding: 2;

                            ItemSlotButton #ArcFlaskButton1 {
                                Anchor: (Full: 0);
                                Style: (
                                    Default: (Background: #1a2530),
                                    Hovered: (Background: #c9a050),
                                    Pressed: (Background: #a08040)
                                );
                                Group {
                                    Anchor: (Full: 0);
                                    Padding: 2;
                                    HitTestVisible: false;
                                    Group {
                                        Anchor: (Full: 0);
                                        Background: "Common/BlockSelectorSlotBackground.png";
                                        HitTestVisible: false;
                                        ItemSlot #ArcFlaskIcon1 {
                                            Anchor: (Full: 0);
                                            ShowQualityBackground: true;
                                            HitTestVisible: false;
                                        }
                                    }
                                }
                            }
                        }

                        Label #ArcFlaskFill1 {
                            Anchor: (Height: 20, Top: 4);
                            Style: (FontSize: 13, TextColor: #90a0b0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }

                    Group { Anchor: (Width: 16); }

                    // Slot 2
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 68);

                        Group #ArcFlaskHighlight2 {
                            Anchor: (Width: 68, Height: 68);
                            Background: #00000000;
                            Padding: 2;

                            ItemSlotButton #ArcFlaskButton2 {
                                Anchor: (Full: 0);
                                Style: (
                                    Default: (Background: #1a2530),
                                    Hovered: (Background: #c9a050),
                                    Pressed: (Background: #a08040)
                                );
                                Group {
                                    Anchor: (Full: 0);
                                    Padding: 2;
                                    HitTestVisible: false;
                                    Group {
                                        Anchor: (Full: 0);
                                        Background: "Common/BlockSelectorSlotBackground.png";
                                        HitTestVisible: false;
                                        ItemSlot #ArcFlaskIcon2 {
                                            Anchor: (Full: 0);
                                            ShowQualityBackground: true;
                                            HitTestVisible: false;
                                        }
                                    }
                                }
                            }
                        }

                        Label #ArcFlaskFill2 {
                            Anchor: (Height: 20, Top: 4);
                            Style: (FontSize: 13, TextColor: #90a0b0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }
                }
            }

            $C.@ContentSeparator {
                Anchor: (Top: 10, Bottom: 10);
            }

            // Flask detail panel — populates when a flask is selected
            Label #FlaskDetailHeader {
                Text: "";
                Anchor: (Bottom: 6);
                Padding: (Horizontal: 20);
                Style: (FontSize: 16, TextColor: #c9a050, HorizontalAlignment: Center, RenderBold: true);
            }

            Label #FlaskDetailContents {
                Text: "";
                Anchor: (Bottom: 12);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #90a0b0, HorizontalAlignment: Center, Wrap: true);
            }

            // Confirm button
            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 44, Bottom: 8);

                ItemSlotButton #ConfirmButton {
                    Anchor: (Width: 220, Height: 38);
                    Style: (
                        Default: (Background: #1a3a20),
                        Hovered: (Background: #2a6a38),
                        Pressed: (Background: #1a4828)
                    );
                    Label #ConfirmLabel {
                        Anchor: (Full: 0);
                        HitTestVisible: false;
                        Style: (FontSize: 16, TextColor: #60d080, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
                        Text: "Select an Element First";
                    }
                }
            }

        }
    }
}