$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 420, Height: 390);

    #Title {
        Label {
            Text: "FLASK POUCH";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            // Pouch slots
            Label {
                Text: "Pouch";
                Anchor: (Top: 10, Bottom: 8);
                Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center);
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 96);

                Group {
                    LayoutMode: Left;

                    // Slot 0
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 68);

                        Group #PouchHighlight0 {
                            Anchor: (Width: 68, Height: 68);
                            Background: #00000000;
                            Padding: 2;

                            ItemSlotButton #PouchButton0 {
                                Anchor: (Full: 0);
                                Style: (
                                    Default: (Background: #1a2530),
                                    Hovered: (Background: #c9a050),
                                    Pressed: (Background: #a08040)
                                );
                                Group {
                                    Anchor: (Full: 0);
                                    Padding: 2;
                                    HitTestVisible: false;
                                    Group {
                                        Anchor: (Full: 0);
                                        Background: "Common/BlockSelectorSlotBackground.png";
                                        HitTestVisible: false;
                                        ItemSlot #PouchIcon0 {
                                            Anchor: (Full: 0);
                                            ShowQualityBackground: true;
                                            HitTestVisible: false;
                                        }
                                    }
                                }
                            }
                        }

                        Label #PouchFill0 {
                            Anchor: (Height: 20, Top: 4);
                            Style: (FontSize: 13, TextColor: #90a0b0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }

                    Group { Anchor: (Width: 16); }

                    // Slot 1
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 68);

                        Group #PouchHighlight1 {
                            Anchor: (Width: 68, Height: 68);
                            Background: #00000000;
                            Padding: 2;

                            ItemSlotButton #PouchButton1 {
                                Anchor: (Full: 0);
                                Style: (
                                    Default: (Background: #1a2530),
                                    Hovered: (Background: #c9a050),
                                    Pressed: (Background: #a08040)
                                );
                                Group {
                                    Anchor: (Full: 0);
                                    Padding: 2;
                                    HitTestVisible: false;
                                    Group {
                                        Anchor: (Full: 0);
                                        Background: "Common/BlockSelectorSlotBackground.png";
                                        HitTestVisible: false;
                                        ItemSlot #PouchIcon1 {
                                            Anchor: (Full: 0);
                                            ShowQualityBackground: true;
                                            HitTestVisible: false;
                                        }
                                    }
                                }
                            }
                        }

                        Label #PouchFill1 {
                            Anchor: (Height: 20, Top: 4);
                            Style: (FontSize: 13, TextColor: #90a0b0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }

                    Group { Anchor: (Width: 16); }

                    // Slot 2
                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 68);

                        Group #PouchHighlight2 {
                            Anchor: (Width: 68, Height: 68);
                            Background: #00000000;
                            Padding: 2;

                            ItemSlotButton #PouchButton2 {
                                Anchor: (Full: 0);
                                Style: (
                                    Default: (Background: #1a2530),
                                    Hovered: (Background: #c9a050),
                                    Pressed: (Background: #a08040)
                                );
                                Group {
                                    Anchor: (Full: 0);
                                    Padding: 2;
                                    HitTestVisible: false;
                                    Group {
                                        Anchor: (Full: 0);
                                        Background: "Common/BlockSelectorSlotBackground.png";
                                        HitTestVisible: false;
                                        ItemSlot #PouchIcon2 {
                                            Anchor: (Full: 0);
                                            ShowQualityBackground: true;
                                            HitTestVisible: false;
                                        }
                                    }
                                }
                            }
                        }

                        Label #PouchFill2 {
                            Anchor: (Height: 20, Top: 4);
                            Style: (FontSize: 13, TextColor: #90a0b0, HorizontalAlignment: Center);
                            Text: "";
                        }
                    }
                }
            }

            $C.@ContentSeparator {
                Anchor: (Top: 8, Bottom: 8);
            }

            // Flask detail panel — populates when a flask is selected
            Label #FlaskDetailHeader {
                Text: "";
                Anchor: (Bottom: 4);
                Padding: (Horizontal: 20);
                Style: (FontSize: 16, TextColor: #c9a050, HorizontalAlignment: Center, RenderBold: true);
            }

            Label #FlaskDetailContents {
                Text: "";
                Anchor: (Bottom: 8);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #90a0b0, HorizontalAlignment: Center, Wrap: true);
            }

            // Inventory flask selection
            Label {
                Text: "Add empty flasks.";
                Anchor: (Bottom: 2);
                Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center);
            }
            Label {
                Text: "Take full flasks to the Menagerie Table.";
                Anchor: (Bottom: 8);
                Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center);
            }

            Group #FlaskList {
                LayoutMode: LeftCenterWrap;
                Padding: (Horizontal: 6);
            }
        }
    }
}