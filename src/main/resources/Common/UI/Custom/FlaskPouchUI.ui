$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 380, Height: 240);

    #Title {
        Label {
            Text: "FLASK POUCH";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            // Pouch slots
            Label {
                Text: "Pouch";
                Anchor: (Top: 6, Bottom: 8);
                Style: (FontSize: 14, TextColor: #5a6a7a, HorizontalAlignment: Center);
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 64);

                Group {
                    LayoutMode: Left;

                    ItemGrid #PouchSlot0 {
                        SlotsPerRow: 1;
                        DisplayItemQuantity: true;
                        RenderItemQualityBackground: true;
                        Style: (
                            SlotSize: 64,
                            SlotIconSize: 52,
                            SlotBackground: "Common/BlockSelectorSlotBackground.png"
                        );
                        Anchor: (Width: 64, Height: 64);
                    }

                    Group { Anchor: (Width: 12); }

                    ItemGrid #PouchSlot1 {
                        SlotsPerRow: 1;
                        DisplayItemQuantity: true;
                        RenderItemQualityBackground: true;
                        Style: (
                            SlotSize: 64,
                            SlotIconSize: 52,
                            SlotBackground: "Common/BlockSelectorSlotBackground.png"
                        );
                        Anchor: (Width: 64, Height: 64);
                    }

                    Group { Anchor: (Width: 12); }

                    ItemGrid #PouchSlot2 {
                        SlotsPerRow: 1;
                        DisplayItemQuantity: true;
                        RenderItemQualityBackground: true;
                        Style: (
                            SlotSize: 64,
                            SlotIconSize: 52,
                            SlotBackground: "Common/BlockSelectorSlotBackground.png"
                        );
                        Anchor: (Width: 64, Height: 64);
                    }
                }
            }

            $C.@ContentSeparator {
                Anchor: (Top: 12, Bottom: 8);
            }

            // Inventory flask selection
            Label {
                Text: "Add empty flasks.";
                Anchor: (Bottom: 2);
                Style: (FontSize: 14, TextColor: #5a6a7a, HorizontalAlignment: Center);
            }
            Label {
                Text: "To remove flasks, fill them using the Arcanoscope.";
                Anchor: (Bottom: 8);
                Style: (FontSize: 14, TextColor: #5a6a7a, HorizontalAlignment: Center);
            }

            Group #FlaskList {
                LayoutMode: LeftCenterWrap;
                Padding: (Horizontal: 6);
            }
        }
    }
}