$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 520, Height: 580);

    #Title {
        Label {
            Text: "MENAGERIE JOURNAL";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;
            FlexWeight: 1;

            // ── Tab bar ───────────────────────────────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 30, Bottom: 4);
                Group {
                    LayoutMode: Left;
                    Anchor: (Width: 496, Height: 30);

                    ItemSlotButton #TabCreaturesButton {
                        Anchor: (Width: 96, Height: 30);
                        Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Creatures";
                        }
                    }

                    ItemSlotButton #TabBestiaryButton {
                        Anchor: (Left: 4, Width: 96, Height: 30);
                        Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Bestiary";
                        }
                    }

                    ItemSlotButton #TabDiscoveriesButton {
                        Anchor: (Left: 4, Width: 96, Height: 30);
                        Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Discoveries";
                        }
                    }

                    ItemSlotButton #TabRecipesButton {
                        Anchor: (Left: 4, Width: 96, Height: 30);
                        Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Recipes";
                        }
                    }

                    ItemSlotButton #TabGuideButton {
                        Anchor: (Left: 4, Width: 96, Height: 30);
                        Style: (Default: (Background: #2a4870), Hovered: (Background: #3a5880), Pressed: (Background: #1a3060));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #c9a050, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
                            Text: "Guide";
                        }
                    }
                }
            }

            $C.@ContentSeparator {
                Anchor: (Top: 8, Bottom: 4);
            }

            // ── Icon ─────────────────────────────────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 52, Bottom: 4);

                ItemSlotButton #GuideIconButton {
                    Anchor: (Width: 48, Height: 48);
                    Style: (Default: (Background: #1a2840), Hovered: (Background: #1a2840), Pressed: (Background: #1a2840));
                    HitTestVisible: false;

                    ItemSlot #GuideIconSlot {
                        Anchor: (Full: 0);
                        ShowQualityBackground: true;
                        HitTestVisible: false;
                    }
                }
            }

            // ── Page title ────────────────────────────────────────────────────

            Label #GuideTitleLabel {
                Text: "";
                Anchor: (Bottom: 6);
                Padding: (Horizontal: 16);
                Style: (FontSize: 17, TextColor: #c9a050, HorizontalAlignment: Center, RenderBold: true);
            }

            $C.@ContentSeparator {
                Anchor: (Top: 4, Bottom: 6);
            }

            // ── Lore text ─────────────────────────────────────────────────────

            Label #GuideLoreLabel {
                Text: "";
                Anchor: (Bottom: 10);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #a080c0, HorizontalAlignment: Center, Wrap: true);
            }

            Group {
                Anchor: (Height: 1, Bottom: 10);
                Background: (Color: #4a5a6a);
            }

            // ── Bullet points ─────────────────────────────────────────────────

            Label #GuideBullet0Label {
                Text: "";
                Anchor: (Bottom: 3);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #c0d0e0, Wrap: true);
            }

            Label #GuideBullet1Label {
                Text: "";
                Anchor: (Bottom: 3);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #c0d0e0, Wrap: true);
            }

            Label #GuideBullet2Label {
                Text: "";
                Anchor: (Bottom: 3);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #c0d0e0, Wrap: true);
            }

            Label #GuideBullet3Label {
                Text: "";
                Anchor: (Bottom: 3);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #c0d0e0, Wrap: true);
            }

            Label #GuideBullet4Label {
                Text: "";
                Anchor: (Bottom: 8);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #c0d0e0, Wrap: true);
            }

            // ── Pagination ────────────────────────────────────────────────────

            Group { FlexWeight: 1; }

            $C.@ContentSeparator {
                Anchor: (Top: 4, Bottom: 6);
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 28, Bottom: 6);
                Group {
                    LayoutMode: Left;
                    Anchor: (Width: 300, Height: 28);

                    ItemSlotButton #PrevButton {
                        Anchor: (Width: 80, Height: 28);
                        Style: (Default: (Background: #1a2530), Hovered: (Background: #c9a050), Pressed: (Background: #a08040));
                        Label #PrevLabel {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #c0d0e0, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "";
                        }
                    }

                    Label #PageLabel {
                        Anchor: (Width: 140, Height: 28);
                        Style: (FontSize: 14, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Text: "1 / 6";
                    }

                    ItemSlotButton #NextButton {
                        Anchor: (Width: 80, Height: 28);
                        Style: (Default: (Background: #1a2530), Hovered: (Background: #c9a050), Pressed: (Background: #a08040));
                        Label #NextLabel {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #c0d0e0, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "";
                        }
                    }
                }
            }

            // ── Close button ──────────────────────────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 34);
                ItemSlotButton #CloseButton {
                    Anchor: (Width: 160, Height: 30);
                    Style: (Default: (Background: #1a2530), Hovered: (Background: #c9a050), Pressed: (Background: #a08040));
                    Label {
                        Anchor: (Full: 0);
                        HitTestVisible: false;
                        Style: (FontSize: 16, TextColor: #c0d0e0, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Text: "Close";
                    }
                }
            }
        }
    }
}

$C.@BackButton {}