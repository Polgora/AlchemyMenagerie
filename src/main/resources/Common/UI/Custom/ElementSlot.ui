Group {
    Anchor: (Width: 260, Height: 30);

    Group #ElementHighlight {
        Anchor: (Full: 0);
        Background: #00000000;
        Padding: 2;

        ItemSlotButton #ElementButton {
            Anchor: (Full: 0);
            Style: (
                Default: (Background: #1a2840),
                Hovered: (Background: #2a4870),
                Pressed: (Background: #122038)
            );

            Label #ElementLabel {
                Anchor: (Full: 0);
                Padding: (Horizontal: 12);
                HitTestVisible: false;
                Style: (
                    FontSize: 14,
                    TextColor: #c890f0,
                    HorizontalAlignment: Start,
                    VerticalAlignment: Center
                );
                Text: "";
            }
        }
    }
}