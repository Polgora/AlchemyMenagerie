$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 520, Height: 640);

    #Title {
        Label {
            Text: "MENAGERIE JOURNAL";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            // ── Tab bar ───────────────────────────────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 30, Bottom: 4);
                Group {
                    LayoutMode: Left;
                    Anchor: (Width: 492, Height: 30);

                    ItemSlotButton #TabCreaturesButton {
                        Anchor: (Width: 120, Height: 30);
                        Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Creatures";
                        }
                    }

                    ItemSlotButton #TabBestiaryButton {
                        Anchor: (Left: 4, Width: 120, Height: 30);
                        Style: (Default: (Background: #2a4870), Hovered: (Background: #3a5880), Pressed: (Background: #1a3060));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #c9a050, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
                            Text: "Bestiary";
                        }
                    }

                    ItemSlotButton #TabDiscoveriesButton {
                        Anchor: (Left: 4, Width: 120, Height: 30);
                        Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Discoveries";
                        }
                    }

                    ItemSlotButton #TabRecipesButton {
                        Anchor: (Left: 4, Width: 120, Height: 30);
                        Style: (Default: (Background: #1a2840), Hovered: (Background: #2a4870), Pressed: (Background: #122038));
                        Label {
                            Anchor: (Full: 0);
                            HitTestVisible: false;
                            Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                            Text: "Recipes";
                        }
                    }
                }
            }

            $C.@ContentSeparator {
                Anchor: (Top: 8, Bottom: 8);
            }

            // ── Back button ───────────────────────────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 26, Bottom: 8);
                ItemSlotButton #BackButton {
                    Anchor: (Width: 140, Height: 26);
                    Style: (Default: (Background: #1a2530), Hovered: (Background: #c9a050), Pressed: (Background: #a08040));
                    Label {
                        Anchor: (Full: 0);
                        HitTestVisible: false;
                        Style: (FontSize: 16, TextColor: #c0d0e0, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Text: "< Back to List";
                    }
                }
            }

            $C.@ContentSeparator {
                Anchor: (Top: 8, Bottom: 8);
            }

            // ── Creature icon ─────────────────────────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 64, Bottom: 6);
                Group #CreatureIcon {
                    Anchor: (Width: 64, Height: 64);
                    Background: "";
                }
            }

            // ── Species name ──────────────────────────────────────────────────

            Label #SpeciesNameLabel {
                Anchor: (Bottom: 6);
                Padding: (Horizontal: 20);
                Style: (FontSize: 16, TextColor: #c9a050, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
                Text: "";
            }

            // ── Description ───────────────────────────────────────────────────

            Label #DescLine0 {
                Anchor: (Bottom: 8);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #90a0b0, HorizontalAlignment: Start, Wrap: true);
                Text: "";
            }

            $C.@ContentSeparator {
                Anchor: (Top: 8, Bottom: 8);
            }

            // ── Diet ──────────────────────────────────────────────────────────

            Label #DietLabel {
                Anchor: (Bottom: 10);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #90a0b0, HorizontalAlignment: Center, VerticalAlignment: Center);
                Text: "";
            }

            // ── Drops header ──────────────────────────────────────────────────

            Label {
                Anchor: (Bottom: 6);
                Padding: (Horizontal: 20);
                Style: (FontSize: 16, TextColor: #6a7a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
                Text: "ANCHOR DROPS";
            }

            // ── Drop rows (up to 5) ───────────────────────────────────────────

            Label #Drop0Label {
                Anchor: (Bottom: 2);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #90a0b0, HorizontalAlignment: Center, VerticalAlignment: Center);
                Text: "";
            }

            Label #Drop1Label {
                Anchor: (Bottom: 2);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #90a0b0, HorizontalAlignment: Center, VerticalAlignment: Center);
                Text: "";
            }

            Label #Drop2Label {
                Anchor: (Bottom: 2);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #90a0b0, HorizontalAlignment: Center, VerticalAlignment: Center);
                Text: "";
            }

            Label #Drop3Label {
                Anchor: (Bottom: 2);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #90a0b0, HorizontalAlignment: Center, VerticalAlignment: Center);
                Text: "";
            }

            Label #Drop4Label {
                Anchor: (Bottom: 8);
                Padding: (Horizontal: 20);
                Style: (FontSize: 14, TextColor: #90a0b0, HorizontalAlignment: Center, VerticalAlignment: Center);
                Text: "";
            }

            $C.@ContentSeparator {
                Anchor: (Top: 8, Bottom: 8);
            }

            // ── Close button ──────────────────────────────────────────────────

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 34);
                ItemSlotButton #CloseButton {
                    Anchor: (Width: 160, Height: 30);
                    Style: (Default: (Background: #1a2530), Hovered: (Background: #c9a050), Pressed: (Background: #a08040));
                    Label {
                        Anchor: (Full: 0);
                        HitTestVisible: false;
                        Style: (FontSize: 16, TextColor: #c0d0e0, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Text: "Close";
                    }
                }
            }
        }
    }
}

$C.@BackButton {}