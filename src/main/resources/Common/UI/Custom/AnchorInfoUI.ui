$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 380, Height: 240);

    #Title {
        Label {
            Text: "MENAGERIE ANCHOR";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            // Anchor display name — gold, bold
            Label #AnchorName {
                Text: "";
                Anchor: (Top: 8, Bottom: 4);
                Style: (FontSize: 17, TextColor: #c9a050, HorizontalAlignment: Center, RenderBold: true);
            }

            // Owner
            Label #AnchorOwner {
                Text: "";
                Anchor: (Bottom: 8);
                Style: (FontSize: 12, TextColor: #5a6a7a, HorizontalAlignment: Center);
            }

            $C.@ContentSeparator {
                Anchor: (Top: 0, Bottom: 8);
            }

            // Rename hint
            Label {
                Text: "Type a name in chat after clicking Rename.";
                Anchor: (Bottom: 10);
                Style: (FontSize: 12, TextColor: #a080c0, HorizontalAlignment: Center);
            }

            // Rename button
            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 44, Bottom: 8);

                ItemSlotButton #RenameButton {
                    Anchor: (Width: 200, Height: 36);
                    Style: (
                        Default: (Background: #1a3a20),
                        Hovered: (Background: #2a6a38),
                        Pressed: (Background: #1a4828)
                    );

                    Label #RenameButtonLabel {
                        Anchor: (Full: 0);
                        HitTestVisible: false;
                        Style: (FontSize: 13, TextColor: #60d080, HorizontalAlignment: Center,
                                VerticalAlignment: Center, RenderBold: true);
                        Text: "Rename";
                    }
                }
            }
        }
    }
}

$C.@BackButton {}