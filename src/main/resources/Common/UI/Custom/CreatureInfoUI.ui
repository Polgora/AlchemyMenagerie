$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 360, Height: 320);

    #Title {
        Label {
            Text: "CREATURE INFO";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            // Creature name — large, gold
            Label #CreatureName {
                Text: "";
                Anchor: (Top: 8, Bottom: 4);
                Style: (FontSize: 16, TextColor: #c9a050, HorizontalAlignment: Center, RenderBold: true);
            }

            // Diet type
            Label #CreatureDiet {
                Text: "";
                Anchor: (Bottom: 6);
                Style: (FontSize: 14, TextColor: #90a0b0, HorizontalAlignment: Center);
            }

            // Owner
            Label #CreatureOwner {
                Text: "";
                Anchor: (Bottom: 6);
                Style: (FontSize: 14, TextColor: #6a7a8a, HorizontalAlignment: Center);
            }

            // Bond level and progress
            Label #BondLevel {
                Text: "";
                Anchor: (Bottom: 12);
                Style: (FontSize: 14, TextColor: #a080c0, HorizontalAlignment: Center, RenderBold: true);
            }

            $C.@ContentSeparator {
                Anchor: (Top: 2, Bottom: 12);
            }

            // Cooldown status — green when ready, amber when waiting
            Label #CooldownLabel {
                Text: "";
                Anchor: (Bottom: 8);
                Style: (FontSize: 16, TextColor: #60d080, HorizontalAlignment: Center, RenderBold: true);
            }

            // Hint for the player
            Label {
                Text: "Hold a food item in your active slot to feed";
                Anchor: (Bottom: 14);
                Padding: (Horizontal: 20);
                Style: (FontSize: 16, TextColor: #a080c0, HorizontalAlignment: Center, Wrap: true);
            }

            $C.@ContentSeparator {
                Anchor: (Top: 2, Bottom: 10);
            }

            // Feed button
            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 44, Bottom: 8);

                ItemSlotButton #FeedButton {
                    Anchor: (Width: 220, Height: 38);
                    Style: (
                        Default: (Background: #1a3a20),
                        Hovered: (Background: #2a6a38),
                        Pressed: (Background: #1a4828)
                    );

                    Label #FeedButtonLabel {
                        Anchor: (Full: 0);
                        HitTestVisible: false;
                        Style: (FontSize: 16, TextColor: #60d080, HorizontalAlignment: Center,
                                VerticalAlignment: Center, RenderBold: true);
                        Text: "Feed";
                    }
                }
            }
        }
    }
}

$C.@BackButton {}