$C = "Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 320, Height: 290);

    #Title {
        Label {
            Text: "MENAGERIE TABLE";
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
    }

    #Content {
        Group {
            LayoutMode: Top;

            Label {
                Text: "Transmutation Successful!";
                Anchor: (Top: 16, Bottom: 14);
                Style: (FontSize: 15, TextColor: #70c080, HorizontalAlignment: Center, RenderBold: true);
            }

            // Single egg slot, centered
            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 88);

                Group {
                    Anchor: (Width: 80, Height: 80);
                    Background: "Common/BlockSelectorSlotBackground.png";

                    ItemSlot #ResultEggSlot {
                        Anchor: (Full: 0);
                        ShowQualityBackground: true;
                        HitTestVisible: false;
                    }
                }
            }

            Label #ResultEggName {
                Text: "";
                Anchor: (Bottom: 14);
                Style: (FontSize: 14, TextColor: #c9a050, HorizontalAlignment: Center);
            }

            $C.@ContentSeparator {
                Anchor: (Top: 4, Bottom: 12);
            }

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Height: 36);

                Button #CollectButton {
                    Anchor: (Width: 200, Height: 36);
                    Style: (
                        Default: (Background: #1a3020),
                        Hovered: (Background: #2a5030),
                        Pressed: (Background: #1a3020)
                    );

                    Label {
                        Anchor: (Full: 0);
                        Style: (FontSize: 14, TextColor: #70c080, HorizontalAlignment: Center,
                                VerticalAlignment: Center, RenderBold: true);
                        Text: "Collect Egg";
                    }
                }
            }
        }
    }
}

$C.@BackButton {}